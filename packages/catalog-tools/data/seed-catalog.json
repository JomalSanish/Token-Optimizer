  "strategies": [
    {
      "id": "prompt-prefix-caching",
      "name": "Prompt Prefix Caching",
      "group": "caching",
      "targets": ["build", "runtime"],
      "summary": "Anchor unchanging system instructions and reference documents at the prompt start to leverage provider prompt cache discounts.",
      "applicability": {
        "path": "llm.avgPrefixTokens",
        "gte": 1024
      },
      "savings": {
        "minPercent": 40,
        "maxPercent": 80,
        "basis": "Cache read pricing reduction on shared prompt prefixes",
        "unit": "percent",
        "appliesTo": "input",
        "sourceUrl": "https://www.anthropic.com/pricing"
      },
      "reviewStatus": "draft",
      "version": 1
    },
    {
      "id": "concise-system-instructions",
      "name": "Concise System Instructions",
